# ==============================================================================
# Arcora (Life OS) - Enterprise Environment Configuration Template
# Copy this file to .env or create environment-specific files (.env.local)
# NEVER COMMIT LIVE SECRETS OR REAL API KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (app/)
# ------------------------------------------------------------------------------

# Firebase Web App Credentials
# Obtain from Firebase Console -> Project Settings -> General -> Your Apps -> Web App
VITE_FIREBASE_API_KEY=AIzaSy_example_api_key_replace_with_yours
VITE_FIREBASE_AUTH_DOMAIN=arcora-example.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=arcora-example
VITE_FIREBASE_STORAGE_BUCKET=arcora-example.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_VAPID_KEY=BN_example_web_push_vapid_certificate_public_key

# Zero-Knowledge Password Vault Salt (Minimum 32 random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITE_ENCRYPTION_SALT=replace_with_random_32_byte_hex_salt_for_client_crypto

# App Brand & Environment Settings
VITE_APP_NAME=Arcora
VITE_APP_VERSION=1.0.0
VITE_PUBLIC_SITE_URL=http://localhost:3000
VITE_ENABLE_SOURCEMAPS=false
VITE_ENABLE_FIREBASE_ANALYTICS=false

# Local Development & Emulators
VITE_USE_FIREBASE_EMULATOR=false

# Intelligent Document Processing (IDP) Backend Integration
VITE_ENABLE_BACKEND_EXTRACTION=true
VITE_EXTRACTION_WORKER_URL=http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 2. BACKEND & CLOUD RUN WORKER CONFIGURATION (backend/cloud-run-worker/)
# ------------------------------------------------------------------------------

# Server Port
PORT=8080

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=arcora-example
FIREBASE_STORAGE_BUCKET=arcora-example.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Multi-Model LLM Gateway Keys
# Primary Vision & Multimodal Extraction
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
# Secondary Fallback Multi-Modal Model
OPENAI_API_KEY=sk-your-openai-api-key-here

# Push Reminder Cron Job Authorization Secret
# Generate with: openssl rand -hex 32
PUSH_JOB_SECRET=your_secure_random_job_secret_string

# Base URL for Action Links in Push Notifications
PUSH_LINK_BASE_URL=https://arcora-example.web.app
