# Cloud Run Worker Environment Configuration
PORT=8080

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Multi-Model AI Orchestrator (Primary: Gemini Flash, Secondary Fallback: OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_key_here

# Scheduled Job Security & Push Notification Links
PUSH_JOB_SECRET=choose_a_long_random_secret
PUSH_LINK_BASE_URL=https://your-project-id.web.app
